    <!-- ===== Error messages (curated, non-revealing — FR-029) ===== -->
    <string name="err_generic_title">Something went wrong</string>
    <string name="err_generic_body">We couldn\'t complete that. Please try again.</string>

    <string name="err_no_connectivity_title">No connection</string>
    <string name="err_no_connectivity_body">Check your internet connection and try again.</string>

    <string name="err_server_title">Service unavailable</string>
    <string name="err_server_body">The service isn\'t responding right now. Please try again shortly.</string>

    <string name="err_timeout_title">Outcome not confirmed</string>
    <string name="err_timeout_body">We didn\'t get a confirmation. Nothing was assumed to have succeeded — re-check before retrying.</string>

    <!-- Deliberately silent about resuming: the download only continues where it stopped when the
         server honours a range request, and a UiMessage carries no format arguments to say which. -->
    <string name="err_download_interrupted_title">Download interrupted</string>
    <string name="err_download_interrupted_body">The connection dropped before the update finished downloading. Try again when the connection is stable.</string>

