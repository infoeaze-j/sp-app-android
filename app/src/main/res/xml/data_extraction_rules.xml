<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules (API 31+). Backup is already disabled at the app level
    (android:allowBackup="false"), but we additionally exclude all app state as defense in depth so no
    session token, verification state, or preference is ever copied off-device (Decision 6, FR-030).
    Biometric frames are never persisted, so they cannot appear here (FR-017).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
