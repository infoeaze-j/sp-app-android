<?xml version="1.0" encoding="utf-8"?>
<!--
    Legacy auto-backup rules (API < 31). Backup is disabled app-wide (allowBackup="false"); these
    explicit exclusions are defense in depth so no app state is ever backed up (Decision 6, FR-030).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
