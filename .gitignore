*.iml
.gradle
/local.properties
/.idea/
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties

# Release signing — the keystore and its passwords must never be committed.
# Losing them means every fleet device needs a manual reinstall (self-update
# only installs over a same-key build). Back them up outside the repo.
keystore.properties
*.jks
*.keystore
/app/release/*

# Sentry CLI credentials — sentry.properties carries an auth token.
sentry.properties

# The detekt CLI, downloaded rather than wired into Gradle (see CLAUDE.md).
# CI fetches its own copy on every run; a local one is ~125 MB of build tool.
detekt-cli-*.zip
detekt-cli-*/
